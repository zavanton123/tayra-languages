<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        The first courses: the three Portuguese courses the app shipped with.
        Loaded everywhere but in the tests, which expect empty tables; edit them afterwards in the admin panel.
    -->
    <changeSet id="20261005200000-1-courses" author="tayra" context="!test">
        <loadData
                  file="../data/course.csv"
                  relativeToChangelogFile="true"
                  separator=";"
                  tableName="course"
                  usePreparedStatements="true">
            <column name="id" type="numeric"/>
            <column name="slug" type="string"/>
            <column name="language_code" type="string"/>
            <column name="title" type="string"/>
            <column name="description" type="string"/>
            <column name="level" type="string"/>
            <column name="topic" type="string"/>
            <column name="sort_order" type="numeric"/>
            <column name="published" type="boolean"/>
        </loadData>
    </changeSet>

    <changeSet id="20261005200000-2-lessons" author="tayra" context="!test">
        <loadData
                  file="../data/lesson.csv"
                  relativeToChangelogFile="true"
                  separator=";"
                  tableName="lesson"
                  usePreparedStatements="true">
            <column name="id" type="numeric"/>
            <column name="slug" type="string"/>
            <column name="title" type="string"/>
            <column name="summary" type="string"/>
            <column name="content" type="clob"/>
            <column name="sort_order" type="numeric"/>
            <column name="course_id" type="numeric"/>
        </loadData>
    </changeSet>
</databaseChangeLog>
