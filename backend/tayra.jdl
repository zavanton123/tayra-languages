/**
 * The Tayra Languages backend: user accounts and the courses the app reads.
 * Regenerate with: jhipster jdl tayra.jdl
 */
application {
  config {
    baseName tayra
    applicationType monolith
    packageName com.tayra.languages.backend
    authenticationType jwt
    buildTool gradle
    prodDatabaseType postgresql
    devDatabaseType h2Disk
    cacheProvider no
    clientFramework angular
    enableTranslation false
    nativeLanguage en
    serverPort 8085
    testFrameworks []
  }
  entities *
}

enum CourseLevel {
  A1, A2, B1, B2
}

/** A course: lessons to read in order, for one language. */
entity Course {
  /** The course's id in the app, stable once published, e.g. pt-primeiros-passos. */
  slug String required unique maxlength(80) pattern(/^[a-z0-9-]+$/)
  /** ISO 639-1 code of the language taught. */
  languageCode String required minlength(2) maxlength(8)
  title String required maxlength(200)
  description String maxlength(1000)
  level CourseLevel required
  topic String maxlength(100)
  /** Where the course comes in the list of its language. */
  sortOrder Integer required min(0)
  /** Only published courses are served to the app. */
  published Boolean required
}

/** A text to read, part of a course. */
entity Lesson {
  /** The lesson's id in the app, stable once published, e.g. pt-primeiros-passos-1. */
  slug String required unique maxlength(80) pattern(/^[a-z0-9-]+$/)
  title String required maxlength(200)
  summary String maxlength(500)
  /** The text of the lesson. */
  content TextBlob required
  /** Where the lesson comes in its course. */
  sortOrder Integer required min(0)
}

relationship ManyToOne {
  Lesson{course(title) required} to Course{lesson}
}

dto * with mapstruct
service * with serviceClass
paginate * with pagination
filter *
