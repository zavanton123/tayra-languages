{
  "annotations": {
    "changelogDate": "20261005195105"
  },
  "applications": ["tayra"],
  "documentation": "A course: lessons to read in order, for one language.",
  "dto": "mapstruct",
  "fields": [
    {
      "documentation": "The course's id in the app, stable once published, e.g. pt-primeiros-passos.",
      "fieldName": "slug",
      "fieldType": "String",
      "fieldValidateRules": ["required", "unique", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "80",
      "fieldValidateRulesPattern": "^[a-z0-9-]+$"
    },
    {
      "documentation": "ISO 639-1 code of the language taught.",
      "fieldName": "languageCode",
      "fieldType": "String",
      "fieldValidateRules": ["required", "minlength", "maxlength"],
      "fieldValidateRulesMaxlength": "8",
      "fieldValidateRulesMinlength": "2"
    },
    {
      "fieldName": "title",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "200"
    },
    {
      "fieldName": "description",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "1000"
    },
    {
      "fieldName": "level",
      "fieldType": "CourseLevel",
      "fieldValidateRules": ["required"],
      "fieldValues": "A1,A2,B1,B2"
    },
    {
      "fieldName": "topic",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "100"
    },
    {
      "documentation": "Where the course comes in the list of its language.",
      "fieldName": "sortOrder",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "documentation": "Only published courses are served to the app.",
      "fieldName": "published",
      "fieldType": "Boolean",
      "fieldValidateRules": ["required"]
    }
  ],
  "jpaMetamodelFiltering": true,
  "name": "Course",
  "pagination": "pagination",
  "relationships": [
    {
      "otherEntityName": "lesson",
      "otherEntityRelationshipName": "course",
      "relationshipName": "lesson",
      "relationshipSide": "right",
      "relationshipType": "one-to-many"
    }
  ],
  "searchEngine": "no",
  "service": "serviceClass"
}
