{
  "annotations": {
    "changelogDate": "20261005195205"
  },
  "applications": ["tayra"],
  "documentation": "A text to read, part of a course.",
  "dto": "mapstruct",
  "fields": [
    {
      "documentation": "The lesson's id in the app, stable once published, e.g. pt-primeiros-passos-1.",
      "fieldName": "slug",
      "fieldType": "String",
      "fieldValidateRules": ["required", "unique", "maxlength", "pattern"],
      "fieldValidateRulesMaxlength": "80",
      "fieldValidateRulesPattern": "^[a-z0-9-]+$"
    },
    {
      "fieldName": "title",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "200"
    },
    {
      "fieldName": "summary",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "500"
    },
    {
      "documentation": "The text of the lesson.",
      "fieldName": "content",
      "fieldType": "TextBlob",
      "fieldValidateRules": ["required"]
    },
    {
      "documentation": "Where the lesson comes in its course.",
      "fieldName": "sortOrder",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "0"
    }
  ],
  "jpaMetamodelFiltering": true,
  "name": "Lesson",
  "pagination": "pagination",
  "relationships": [
    {
      "otherEntityField": "title",
      "otherEntityName": "course",
      "otherEntityRelationshipName": "lesson",
      "relationshipName": "course",
      "relationshipSide": "left",
      "relationshipType": "many-to-one",
      "relationshipValidateRules": "required"
    }
  ],
  "searchEngine": "no",
  "service": "serviceClass"
}
