{
  "name": "tayra-browser-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "zip:store": "TAYRA_STORE=1 wxt zip && TAYRA_STORE=1 wxt zip -b firefox --mv3",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wxt": "0.21.4"
  }
}
