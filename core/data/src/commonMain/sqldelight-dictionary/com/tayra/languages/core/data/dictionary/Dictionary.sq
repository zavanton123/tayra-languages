-- Mirrors the schema written by tools/build_dictionary.py; the file is never created here.
CREATE TABLE meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE entries (
    id INTEGER NOT NULL PRIMARY KEY,
    word TEXT NOT NULL,
    word_lc TEXT NOT NULL,
    pos TEXT NOT NULL,
    ipa TEXT,
    senses TEXT NOT NULL
);

CREATE INDEX entries_word_lc ON entries(word_lc);

CREATE TABLE forms (
    form_lc TEXT NOT NULL,
    lemma TEXT NOT NULL,
    generated INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE INDEX forms_form_lc ON forms(form_lc);

-- Optional tables: only the packs of some languages have them, so queries on them may fail.
CREATE TABLE readings (
    word TEXT NOT NULL,
    reading TEXT NOT NULL
);

CREATE TABLE kanji (
    character TEXT NOT NULL PRIMARY KEY,
    meanings TEXT NOT NULL,
    onyomi TEXT NOT NULL,
    kunyomi TEXT NOT NULL,
    strokes INTEGER,
    grade INTEGER,
    jlpt INTEGER,
    frequency INTEGER
);

-- The reading of each entry, where a word has entries for several readings (打つ read うつ and ぶつ).
CREATE TABLE entry_readings (
    entry_id INTEGER NOT NULL PRIMARY KEY,
    reading TEXT NOT NULL
);

-- The entries of common words, as JMdict marks them (news1, ichi1, spec1, gai1).
CREATE TABLE common_entries (
    entry_id INTEGER NOT NULL PRIMARY KEY
);

CREATE TABLE frequencies (
    word TEXT NOT NULL,
    reading TEXT,
    value INTEGER,
    display TEXT
);

CREATE TABLE pitch (
    word TEXT NOT NULL,
    reading TEXT NOT NULL,
    positions TEXT NOT NULL
);

selectMeta:
SELECT value FROM meta WHERE key = :key;

selectEntries:
SELECT id, word, pos, ipa, senses FROM entries WHERE word_lc = :wordLc ORDER BY id;

selectEntriesIn:
SELECT id, word_lc, word, pos, ipa, senses FROM entries WHERE word_lc IN ? ORDER BY id;

selectWords:
SELECT word_lc FROM entries UNION SELECT form_lc FROM forms;

selectLemmas:
SELECT lemma FROM forms WHERE form_lc = :formLc ORDER BY generated, lemma;

selectReadings:
SELECT word, reading FROM readings WHERE word IN ?;

selectKanji:
SELECT * FROM kanji WHERE character IN ?;

selectPitch:
SELECT word, reading, positions FROM pitch WHERE word IN ?;

selectEntryReadings:
SELECT entry_id, reading FROM entry_readings WHERE entry_id IN ?;

selectFrequencies:
SELECT word, reading, value, display FROM frequencies WHERE word IN ?;

selectCommonEntries:
SELECT entry_id FROM common_entries WHERE entry_id IN ?;
