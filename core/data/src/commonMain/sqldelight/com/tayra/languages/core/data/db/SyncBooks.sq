-- What sync reads and writes of texts and reading. A text is known on every device by the lesson it
-- was made from, the address of a pack's book, its language for a tutorial, or else its own sync id;
-- see BookSync.kt.

changedBooks:
SELECT b.id, l.name AS language, b.sync_id, b.source_uri, b.title, b.archived, b.updated_at, cl.lesson_id, na.url AS news, cp.page_order AS current_page,
    coalesce((SELECT group_concat(t.text, char(31)) FROM book_tag_map m JOIN book_tags t ON t.id = m.tag_id WHERE m.book_id = b.id), '') AS tags,
    (SELECT count(*) FROM pages p WHERE p.book_id = b.id) AS page_count
FROM books b JOIN languages l ON l.id = b.language_id
LEFT JOIN course_lessons cl ON cl.book_id = b.id
LEFT JOIN news_articles na ON na.book_id = b.id
LEFT JOIN pages cp ON cp.id = b.current_page_id
WHERE b.updated_at > :since;

bookOfLesson:
SELECT b.id, l.name AS language, b.sync_id, b.source_uri, b.title, b.archived, b.updated_at, cl.lesson_id, na.url AS news, cp.page_order AS current_page,
    coalesce((SELECT group_concat(t.text, char(31)) FROM book_tag_map m JOIN book_tags t ON t.id = m.tag_id WHERE m.book_id = b.id), '') AS tags,
    (SELECT count(*) FROM pages p WHERE p.book_id = b.id) AS page_count
FROM books b JOIN languages l ON l.id = b.language_id
LEFT JOIN course_lessons cl ON cl.book_id = b.id
LEFT JOIN news_articles na ON na.book_id = b.id
LEFT JOIN pages cp ON cp.id = b.current_page_id
WHERE cl.lesson_id = :lessonId;

bookOfSource:
SELECT b.id, l.name AS language, b.sync_id, b.source_uri, b.title, b.archived, b.updated_at, cl.lesson_id, na.url AS news, cp.page_order AS current_page,
    coalesce((SELECT group_concat(t.text, char(31)) FROM book_tag_map m JOIN book_tags t ON t.id = m.tag_id WHERE m.book_id = b.id), '') AS tags,
    (SELECT count(*) FROM pages p WHERE p.book_id = b.id) AS page_count
FROM books b JOIN languages l ON l.id = b.language_id
LEFT JOIN course_lessons cl ON cl.book_id = b.id
LEFT JOIN news_articles na ON na.book_id = b.id
LEFT JOIN pages cp ON cp.id = b.current_page_id
WHERE b.source_uri = :source AND cl.lesson_id IS NULL
ORDER BY b.id LIMIT 1;

bookOfSyncId:
SELECT b.id, l.name AS language, b.sync_id, b.source_uri, b.title, b.archived, b.updated_at, cl.lesson_id, na.url AS news, cp.page_order AS current_page,
    coalesce((SELECT group_concat(t.text, char(31)) FROM book_tag_map m JOIN book_tags t ON t.id = m.tag_id WHERE m.book_id = b.id), '') AS tags,
    (SELECT count(*) FROM pages p WHERE p.book_id = b.id) AS page_count
FROM books b JOIN languages l ON l.id = b.language_id
LEFT JOIN course_lessons cl ON cl.book_id = b.id
LEFT JOIN news_articles na ON na.book_id = b.id
LEFT JOIN pages cp ON cp.id = b.current_page_id
WHERE b.sync_id = :syncId;

bookOfId:
SELECT b.id, l.name AS language, b.sync_id, b.source_uri, b.title, b.archived, b.updated_at, cl.lesson_id, na.url AS news, cp.page_order AS current_page,
    coalesce((SELECT group_concat(t.text, char(31)) FROM book_tag_map m JOIN book_tags t ON t.id = m.tag_id WHERE m.book_id = b.id), '') AS tags,
    (SELECT count(*) FROM pages p WHERE p.book_id = b.id) AS page_count
FROM books b JOIN languages l ON l.id = b.language_id
LEFT JOIN course_lessons cl ON cl.book_id = b.id
LEFT JOIN news_articles na ON na.book_id = b.id
LEFT JOIN pages cp ON cp.id = b.current_page_id
WHERE b.id = :id;

-- Books of the language with the title that are no lesson's and have no source: a tutorial, or a text
-- from another device made here too.
booksTitled:
SELECT b.id FROM books b
WHERE b.language_id = :languageId AND b.title = :title AND b.source_uri IS NULL AND b.id NOT IN (SELECT book_id FROM course_lessons)
ORDER BY b.id;

firstPageText:
SELECT text FROM pages WHERE book_id = :bookId AND page_order = 1;

insertBook:
INSERT INTO books(language_id, title, source_uri, archived, sync_id, updated_at)
VALUES (:languageId, :title, :sourceUri, :archived, :syncId, :updatedAt);

lastBookId:
SELECT last_insert_rowid();

updateBook:
UPDATE books SET title = :title, source_uri = :sourceUri, archived = :archived, updated_at = :updatedAt WHERE id = :id;

setBookProgress:
UPDATE books SET archived = :archived, updated_at = :updatedAt WHERE id = :id;

setCurrentPage:
UPDATE books SET current_page_id = (SELECT id FROM pages WHERE book_id = :id AND page_order = :pageOrder) WHERE id = :id;

adoptBook:
UPDATE books SET sync_id = :syncId WHERE id = :id;

deleteBook:
DELETE FROM books WHERE id = :id;

clearBookTags:
DELETE FROM book_tag_map WHERE book_id = :bookId;

tagId:
SELECT id FROM book_tags WHERE text = :text;

addTag:
INSERT OR IGNORE INTO book_tags(text) VALUES (:text);

tagBook:
INSERT OR IGNORE INTO book_tag_map(book_id, tag_id) VALUES (:bookId, :tagId);

linkNews:
INSERT OR REPLACE INTO news_articles(url, book_id) VALUES (:url, :bookId);

clearStats:
DELETE FROM book_stats WHERE book_id = :bookId;

changedPages:
SELECT p.page_order, p.text, p.word_count, p.start_date, p.read_date, p.updated_at, b.sync_id, b.source_uri, cl.lesson_id, b.title, l.name AS language
FROM pages p JOIN books b ON b.id = p.book_id JOIN languages l ON l.id = b.language_id LEFT JOIN course_lessons cl ON cl.book_id = b.id
WHERE p.updated_at > :since;

pageOf:
SELECT p.page_order, p.text, p.word_count, p.start_date, p.read_date, p.updated_at, b.sync_id, b.source_uri, cl.lesson_id, b.title, l.name AS language
FROM pages p JOIN books b ON b.id = p.book_id JOIN languages l ON l.id = b.language_id LEFT JOIN course_lessons cl ON cl.book_id = b.id
WHERE p.book_id = :bookId AND p.page_order = :pageOrder;

pageId:
SELECT id FROM pages WHERE book_id = :bookId AND page_order = :pageOrder;

insertPage:
INSERT INTO pages(book_id, page_order, text, word_count, start_date, read_date, updated_at)
VALUES (:bookId, :pageOrder, :text, :wordCount, :startDate, :readDate, :updatedAt);

updatePage:
UPDATE pages SET text = :text, word_count = :wordCount, start_date = :startDate, read_date = :readDate, updated_at = :updatedAt
WHERE book_id = :bookId AND page_order = :pageOrder;

setPageDates:
UPDATE pages SET start_date = :startDate, read_date = :readDate, updated_at = :updatedAt WHERE book_id = :bookId AND page_order = :pageOrder;

deletePage:
DELETE FROM pages WHERE book_id = :bookId AND page_order = :pageOrder;

deletePagesAfter:
DELETE FROM pages WHERE book_id = :bookId AND page_order > :pageCount;

changedBookmarks:
SELECT bm.id, bm.title, bm.created_at, bm.updated_at, p.page_order, b.sync_id, b.source_uri, cl.lesson_id, b.title AS book_title, l.name AS language
FROM page_bookmarks bm JOIN pages p ON p.id = bm.page_id JOIN books b ON b.id = p.book_id JOIN languages l ON l.id = b.language_id LEFT JOIN course_lessons cl ON cl.book_id = b.id
WHERE bm.updated_at > :since;

bookmarkMadeAt:
SELECT bm.id, bm.title, bm.created_at, bm.updated_at, p.page_order, b.sync_id, b.source_uri, cl.lesson_id, b.title AS book_title, l.name AS language
FROM page_bookmarks bm JOIN pages p ON p.id = bm.page_id JOIN books b ON b.id = p.book_id JOIN languages l ON l.id = b.language_id LEFT JOIN course_lessons cl ON cl.book_id = b.id
WHERE bm.page_id = :pageId AND bm.created_at = :createdAt;

bookmarkTitled:
SELECT bm.id, bm.title, bm.created_at, bm.updated_at, p.page_order, b.sync_id, b.source_uri, cl.lesson_id, b.title AS book_title, l.name AS language
FROM page_bookmarks bm JOIN pages p ON p.id = bm.page_id JOIN books b ON b.id = p.book_id JOIN languages l ON l.id = b.language_id LEFT JOIN course_lessons cl ON cl.book_id = b.id
WHERE bm.page_id = :pageId AND bm.created_at IS NULL AND bm.title = :title;

insertBookmark:
INSERT INTO page_bookmarks(page_id, title, created_at, updated_at) VALUES (:pageId, :title, :createdAt, :updatedAt);

renameBookmark:
UPDATE page_bookmarks SET title = :title, updated_at = :updatedAt WHERE id = :id;

deleteBookmark:
DELETE FROM page_bookmarks WHERE id = :id;

changedWordsRead:
SELECT w.read_at, w.word_count, w.updated_at, l.name AS language, p.page_order, b.sync_id, b.source_uri, cl.lesson_id, b.title AS book_title
FROM words_read w JOIN languages l ON l.id = w.language_id
LEFT JOIN pages p ON p.id = w.page_id LEFT JOIN books b ON b.id = p.book_id LEFT JOIN course_lessons cl ON cl.book_id = b.id
WHERE w.updated_at > :since;

wordsReadAt:
SELECT count(*) FROM words_read WHERE language_id = :languageId AND read_at = :readAt;

insertWordsRead:
INSERT INTO words_read(language_id, page_id, read_at, word_count, updated_at) VALUES (:languageId, :pageId, :readAt, :wordCount, :updatedAt);

bookIdOfSyncId:
SELECT id FROM books WHERE sync_id = :syncId;

oversizedBooks:
SELECT b.sync_id FROM books b JOIN pages p ON p.book_id = b.id GROUP BY b.id HAVING sum(length(p.text)) > :max;
