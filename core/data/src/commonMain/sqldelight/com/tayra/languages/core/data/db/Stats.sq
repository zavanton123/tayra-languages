-- Figures for the Statistics screen, one language at a time.

termStatusCounts:
SELECT status, count(*) AS term_count FROM terms WHERE language_id = :languageId GROUP BY status;

-- When the reader saved each word being learned (statuses 1 to 4): words marked known or ignored on
-- sight were not added to learn, and the vocabulary level's known words were not saved by hand.
termSavedTimes:
SELECT created_at FROM terms
WHERE language_id = :languageId AND status BETWEEN 1 AND 4 AND id NOT IN (SELECT term_id FROM level_terms);

reviewTimes:
SELECT r.reviewed_at, r.rating FROM flashcard_reviews r INNER JOIN terms t ON t.id = r.term_id
WHERE t.language_id = :languageId;

pagesRead:
SELECT count(*) FROM pages p INNER JOIN books b ON b.id = p.book_id
WHERE b.language_id = :languageId AND p.read_date IS NOT NULL;

-- A book is finished once its last page is read.
booksFinished:
SELECT count(*) FROM books b
WHERE b.language_id = :languageId
  AND (SELECT p.read_date FROM pages p WHERE p.book_id = b.id ORDER BY p.page_order DESC LIMIT 1) IS NOT NULL;
