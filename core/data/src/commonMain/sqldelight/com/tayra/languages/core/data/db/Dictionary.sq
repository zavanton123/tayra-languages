CREATE TABLE dictionary_imports (
    dictionary TEXT NOT NULL PRIMARY KEY,
    format INTEGER NOT NULL,
    entry_count INTEGER NOT NULL,
    imported_at INTEGER NOT NULL
);

CREATE TABLE dictionary_entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    dictionary TEXT NOT NULL,
    word TEXT NOT NULL,
    word_lc TEXT NOT NULL,
    pos TEXT NOT NULL,
    ipa TEXT,
    senses TEXT NOT NULL
);

CREATE INDEX dictionary_entries_word ON dictionary_entries(dictionary, word_lc);

CREATE TABLE dictionary_forms (
    dictionary TEXT NOT NULL,
    form_lc TEXT NOT NULL,
    lemma TEXT NOT NULL,
    generated INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

CREATE INDEX dictionary_forms_form ON dictionary_forms(dictionary, form_lc);

selectImport:
SELECT format, entry_count FROM dictionary_imports WHERE dictionary = :dictionary;

upsertImport:
INSERT OR REPLACE INTO dictionary_imports(dictionary, format, entry_count, imported_at) VALUES (:dictionary, :format, :entryCount, :importedAt);

deleteImport:
DELETE FROM dictionary_imports WHERE dictionary = :dictionary;

deleteEntries:
DELETE FROM dictionary_entries WHERE dictionary = :dictionary;

deleteForms:
DELETE FROM dictionary_forms WHERE dictionary = :dictionary;

selectEntries:
SELECT word, pos, ipa, senses FROM dictionary_entries WHERE dictionary = :dictionary AND word_lc = :wordLc ORDER BY id;

selectLemmas:
SELECT lemma FROM dictionary_forms WHERE dictionary = :dictionary AND form_lc = :formLc ORDER BY generated, lemma;
