WHEN (SELECT applying FROM sync_state WHERE id = 1) IS NOT 1 AND EXISTS (SELECT 1 FROM terms WHERE id = old.term_id)
BEGIN
    INSERT OR REPLACE INTO sync_tombstones(kind, scope, key, deleted_at) VALUES ('flashcard', (SELECT l.name FROM terms t JOIN languages l ON l.id = t.language_id WHERE t.id = old.term_id), (SELECT text_lc FROM terms WHERE id = old.term_id), CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
END;

