state:
SELECT * FROM sync_state WHERE id = 1;

-- Writes made between applying(1) and applying(0), in one transaction, are not this device's own changes.
setApplying:
UPDATE sync_state SET applying = ? WHERE id = 1;

-- The library was replaced or emptied: the next sync sends every record and takes every record afresh.
startOver:
UPDATE sync_state SET last_seq = 0, last_push_at = NULL, full_push = 1 WHERE id = 1;

clearTombstones:
DELETE FROM sync_tombstones;

tombstones:
SELECT * FROM sync_tombstones ORDER BY deleted_at;
