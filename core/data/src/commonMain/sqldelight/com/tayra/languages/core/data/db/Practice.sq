-- Sentences from elsewhere kept for a word being learned, so practice can ask it in new contexts
-- without the network; each records the form of the word it uses and where that form starts.
CREATE TABLE practice_examples (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    term_id INTEGER NOT NULL REFERENCES terms(id) ON DELETE CASCADE,
    sentence TEXT NOT NULL,
    translation TEXT,
    form TEXT NOT NULL,
    form_start INTEGER NOT NULL,
    source TEXT NOT NULL,
    source_id TEXT,
    fetched_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL DEFAULT 0,
    UNIQUE (term_id, sentence)
);

CREATE INDEX practice_examples_term ON practice_examples(term_id);

-- How far practice has taken each word: its level on the way from recognising it to producing it,
-- and the run of right (positive) or wrong (negative) answers that moves it.
CREATE TABLE practice_progress (
    term_id INTEGER NOT NULL PRIMARY KEY REFERENCES terms(id) ON DELETE CASCADE,
    level INTEGER NOT NULL DEFAULT 0,
    streak INTEGER NOT NULL DEFAULT 0,
    asked INTEGER NOT NULL DEFAULT 0,
    right_answers INTEGER NOT NULL DEFAULT 0,
    last_practised INTEGER,
    updated_at INTEGER NOT NULL DEFAULT 0
);

selectExamples:
SELECT * FROM practice_examples WHERE term_id IN ? ORDER BY term_id, id;

countExamples:
SELECT term_id, count(*) FROM practice_examples WHERE term_id IN ? GROUP BY term_id;

insertExample:
INSERT OR IGNORE INTO practice_examples(term_id, sentence, translation, form, form_start, source, source_id, fetched_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteExamples:
DELETE FROM practice_examples WHERE term_id = ?;

selectProgress:
SELECT * FROM practice_progress WHERE term_id IN ?;

upsertProgress:
INSERT OR REPLACE INTO practice_progress(term_id, level, streak, asked, right_answers, last_practised)
VALUES (?, ?, ?, ?, ?, ?);
