-- Courses and lessons get tags. The tables are rebuilt rather than given new columns, so this runs
-- whether a column is there already or not. The courses written from the first course pack are the
-- app's own and get the "tayra" tag.
CREATE TABLE courses_v17 (
    id TEXT NOT NULL PRIMARY KEY,
    language_id INTEGER NOT NULL REFERENCES languages(id) ON DELETE CASCADE,
    title TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    level TEXT NOT NULL,
    topic TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL,
    built_in INTEGER NOT NULL DEFAULT 0,
    rank_up_to INTEGER,
    tags TEXT NOT NULL DEFAULT ''
);

INSERT INTO courses_v17(id, language_id, title, description, level, topic, created_at, built_in, rank_up_to)
SELECT id, language_id, title, description, level, topic, created_at, built_in, rank_up_to FROM courses;

-- The lessons wait in a table without links while their course table is replaced.
CREATE TABLE lessons_v17 (
    id TEXT NOT NULL PRIMARY KEY,
    course_id TEXT NOT NULL,
    title TEXT NOT NULL,
    summary TEXT NOT NULL DEFAULT '',
    text TEXT NOT NULL,
    position INTEGER NOT NULL,
    new_words TEXT NOT NULL DEFAULT ''
);

INSERT INTO lessons_v17(id, course_id, title, summary, text, position, new_words)
SELECT id, course_id, title, summary, text, position, new_words FROM lessons;

DROP TABLE lessons;
DROP TABLE courses;
ALTER TABLE courses_v17 RENAME TO courses;

CREATE TABLE lessons (
    id TEXT NOT NULL PRIMARY KEY,
    course_id TEXT NOT NULL REFERENCES courses(id) ON DELETE CASCADE,
    title TEXT NOT NULL,
    summary TEXT NOT NULL DEFAULT '',
    text TEXT NOT NULL,
    position INTEGER NOT NULL,
    new_words TEXT NOT NULL DEFAULT '',
    tags TEXT NOT NULL DEFAULT ''
);

INSERT INTO lessons(id, course_id, title, summary, text, position, new_words)
SELECT id, course_id, title, summary, text, position, new_words FROM lessons_v17;

DROP TABLE lessons_v17;

CREATE INDEX IF NOT EXISTS lessons_course ON lessons(course_id, position);

UPDATE courses SET tags = 'tayra' WHERE built_in = 1 AND id LIKE 'pt-mini-%';
UPDATE lessons SET tags = 'tayra' WHERE course_id IN (SELECT id FROM courses WHERE built_in = 1 AND id LIKE 'pt-mini-%');
