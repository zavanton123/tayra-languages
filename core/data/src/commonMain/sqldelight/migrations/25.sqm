-- Playlists: texts to listen to one after another, with the place listening got to, kept apart from
-- the reading progress of the texts.
CREATE TABLE IF NOT EXISTS playlists (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    language_id INTEGER NOT NULL REFERENCES languages(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    cover INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    last_played_at INTEGER,
    current_item_id INTEGER,
    current_page INTEGER NOT NULL DEFAULT 1,
    current_sentence INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS playlists_language ON playlists(language_id);

CREATE TABLE IF NOT EXISTS playlist_items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    playlist_id INTEGER NOT NULL REFERENCES playlists(id) ON DELETE CASCADE,
    book_id INTEGER NOT NULL REFERENCES books(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    finished_at INTEGER,
    UNIQUE (playlist_id, book_id)
);

CREATE INDEX IF NOT EXISTS playlist_items_playlist ON playlist_items(playlist_id, position);

CREATE INDEX IF NOT EXISTS playlist_items_book ON playlist_items(book_id);
