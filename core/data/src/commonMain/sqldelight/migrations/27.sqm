CREATE TRIGGER sync_flashcards_insert
AFTER INSERT ON flashcards
WHEN (SELECT applying FROM sync_state WHERE id = 1) IS NOT 1
BEGIN
    UPDATE flashcards SET updated_at = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER) WHERE term_id = new.term_id;
END;

CREATE TRIGGER sync_flashcards_update
AFTER UPDATE OF state, due, stability, difficulty, interval_days, remaining_steps, reps, lapses, last_review, suspended, seen_status ON flashcards
WHEN (SELECT applying FROM sync_state WHERE id = 1) IS NOT 1
BEGIN
    UPDATE flashcards SET updated_at = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER) WHERE term_id = new.term_id;
END;

CREATE TRIGGER sync_flashcards_delete
AFTER DELETE ON flashcards
WHEN (SELECT applying FROM sync_state WHERE id = 1) IS NOT 1 AND EXISTS (SELECT 1 FROM terms WHERE id = old.term_id)
BEGIN
    INSERT OR REPLACE INTO sync_tombstones(kind, scope, key, deleted_at) VALUES ('flashcard', (SELECT l.name FROM terms t JOIN languages l ON l.id = t.language_id WHERE t.id = old.term_id), (SELECT text_lc FROM terms WHERE id = old.term_id), CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
END;

CREATE TRIGGER sync_flashcard_reviews_insert
AFTER INSERT ON flashcard_reviews
WHEN (SELECT applying FROM sync_state WHERE id = 1) IS NOT 1
BEGIN
    UPDATE flashcard_reviews SET updated_at = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER) WHERE id = new.id;
