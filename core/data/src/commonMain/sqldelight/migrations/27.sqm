-- Sync: when each record was last changed, ids that are the same on every device for books and
-- playlists, the deletions not yet sent, and the triggers that keep them; see Sync.sq.
ALTER TABLE terms ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE flashcards ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE flashcard_reviews ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE practice_progress ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE practice_examples ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE vocabulary_levels ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE languages ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE books ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE books ADD COLUMN sync_id TEXT;
ALTER TABLE pages ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE page_bookmarks ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE words_read ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE playlists ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE playlists ADD COLUMN sync_id TEXT;

-- What was there before counts as changed when it last visibly was, or now.
UPDATE terms SET updated_at = max(created_at, status_changed_at);
UPDATE flashcards SET updated_at = coalesce(last_review, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
UPDATE flashcard_reviews SET updated_at = reviewed_at;
UPDATE practice_progress SET updated_at = coalesce(last_practised, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
UPDATE practice_examples SET updated_at = fetched_at;
UPDATE vocabulary_levels SET updated_at = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER);
UPDATE books SET updated_at = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER), sync_id = lower(hex(randomblob(16)));
UPDATE pages SET updated_at = coalesce(read_date, start_date, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
UPDATE page_bookmarks SET updated_at = coalesce(created_at, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
UPDATE words_read SET updated_at = read_at;
UPDATE playlists SET updated_at = coalesce(last_played_at, created_at), sync_id = lower(hex(randomblob(16)));

-- What sync keeps on each device: one row of state, and the records deleted since they were last sent.
-- Every synced row carries updated_at, stamped by the triggers below whenever the app writes it; rows
-- written while applying is 1 (a pull from the account, a restore, a wipe) keep the time they came with.
CREATE TABLE IF NOT EXISTS sync_state (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    device_id TEXT NOT NULL,
    applying INTEGER NOT NULL DEFAULT 0,
    -- The account's change number this device has pulled up to.
    last_seq INTEGER NOT NULL DEFAULT 0,
    -- When this device last sent its changes, in epoch milliseconds; null before the first time.
    last_push_at INTEGER,
    -- Whether the next sync sends every record, not only the changed ones: after a restore or a wipe.
    full_push INTEGER NOT NULL DEFAULT 1
);

INSERT INTO sync_state(id, device_id) VALUES (1, lower(hex(randomblob(16))));

-- A record deleted on this device: its kind, the language or text it belongs to (scope), and its key there.
CREATE TABLE IF NOT EXISTS sync_tombstones (
    kind TEXT NOT NULL,
    scope TEXT NOT NULL DEFAULT '',
    key TEXT NOT NULL,
    deleted_at INTEGER NOT NULL,
    PRIMARY KEY (kind, scope, key)
);

CREATE INDEX IF NOT EXISTS terms_updated_at ON terms(updated_at);

CREATE INDEX IF NOT EXISTS pages_updated_at ON pages(updated_at);

CREATE UNIQUE INDEX IF NOT EXISTS books_sync_id ON books(sync_id);

CREATE UNIQUE INDEX IF NOT EXISTS playlists_sync_id ON playlists(sync_id);

CREATE TRIGGER sync_terms_insert
AFTER INSERT ON terms
WHEN (SELECT applying FROM sync_state WHERE id = 1) IS NOT 1
BEGIN
    UPDATE terms SET updated_at = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER) WHERE id = new.id;
END;

CREATE TRIGGER sync_terms_update
AFTER UPDATE OF text, text_lc, status, translation, romanization, token_count, flash_message, translation_language, sentence ON terms
WHEN (SELECT applying FROM sync_state WHERE id = 1) IS NOT 1
BEGIN
    UPDATE terms SET updated_at = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER) WHERE id = new.id;
END;

CREATE TRIGGER sync_terms_delete
AFTER DELETE ON terms
WHEN (SELECT applying FROM sync_state WHERE id = 1) IS NOT 1 AND old.status <> 0 AND EXISTS (SELECT 1 FROM languages WHERE id = old.language_id)
BEGIN
    INSERT OR REPLACE INTO sync_tombstones(kind, scope, key, deleted_at) VALUES ('term', (SELECT name FROM languages WHERE id = old.language_id), old.text_lc, CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER));
END;

