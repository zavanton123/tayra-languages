AFTER INSERT ON term_parents
WHEN (SELECT applying FROM sync_state WHERE id = 1) IS NOT 1
BEGIN
    UPDATE terms SET updated_at = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER) WHERE id = new.term_id;
END;

