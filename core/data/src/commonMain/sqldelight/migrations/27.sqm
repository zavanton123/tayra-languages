CREATE TRIGGER sync_books_insert
AFTER INSERT ON books
BEGIN
    UPDATE books SET sync_id = coalesce(sync_id, lower(hex(randomblob(16)))), updated_at = CASE WHEN (SELECT applying FROM sync_state WHERE id = 1) IS NOT 1 THEN CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER) ELSE updated_at END WHERE id = new.id;
END;

