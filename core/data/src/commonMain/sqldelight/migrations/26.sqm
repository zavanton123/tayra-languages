-- Practice: example sentences kept for words being learned, and how far practice has taken each word.
CREATE TABLE IF NOT EXISTS practice_examples (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    term_id INTEGER NOT NULL REFERENCES terms(id) ON DELETE CASCADE,
    sentence TEXT NOT NULL,
    translation TEXT,
    form TEXT NOT NULL,
    form_start INTEGER NOT NULL,
    source TEXT NOT NULL,
    source_id TEXT,
    fetched_at INTEGER NOT NULL,
    UNIQUE (term_id, sentence)
);

CREATE INDEX IF NOT EXISTS practice_examples_term ON practice_examples(term_id);

CREATE TABLE IF NOT EXISTS practice_progress (
    term_id INTEGER NOT NULL PRIMARY KEY REFERENCES terms(id) ON DELETE CASCADE,
    level INTEGER NOT NULL DEFAULT 0,
    streak INTEGER NOT NULL DEFAULT 0,
    asked INTEGER NOT NULL DEFAULT 0,
    right_answers INTEGER NOT NULL DEFAULT 0,
    last_practised INTEGER
);
